+/** The sourcing fields Sprocket's KiCad skill asks agents to give every part. */
+export const BOM_FIELDS = [
+    "Manufacturer",
+    "MPN",
+    "Digikey Part #",
+    "Mouser Part #",
+    "LCSC Part #",
+    "JLCPCB Part #",
+] as const;
+
+export type BomField = (typeof BOM_FIELDS)[number];
+
+export type BomFields = Record<BomField, string>;
+
+export function read_bom_fields(
+    read: (name: string) => string | undefined,
+): BomFields {
+    return Object.fromEntries(
+        BOM_FIELDS.map((name) => [name, read(name)?.trim() ?? ""]),
+    ) as BomFields;
+}
+
+/** KiCad writes `~` for an empty datasheet. */
+export const bom_datasheet = (item: BomItem) =>
+    item.Datasheet.trim() === "~" ? "" : item.Datasheet.trim();
+
 export interface BomItem {
     Reference: string;
     Name: string;
