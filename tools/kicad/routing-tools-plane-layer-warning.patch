+def plane_layers(pcb_data) -> Dict[str, str]:
+    """{inner copper layer: the net with the most pour area on it, when that
+    covers at least PLANE_COVER of the board's bounding box}. Outer layers are
+    left out: a pour there is a flood around the signal copper, not a plane to
+    keep tracks off."""
+    from kicad_parser import pour_zones
+    from kicad_writer import _polygon_area
+    bounds = pcb_data.board_info.board_bounds
+    board = (bounds[2] - bounds[0]) * (bounds[3] - bounds[1]) if bounds else 0.0
+    if board <= 0:
+        return {}
+    area = {layer: defaultdict(float) for layer in pcb_data.board_info.copper_layers[1:-1]}
+    for z in pour_zones(getattr(pcb_data, 'zones', None)):
+        if z.layer in area and z.net_id:
+            area[z.layer][z.net_name] += (_polygon_area(z.polygon)
+                                          - sum(_polygon_area(h) for h in z.holes))
+    planes = {}
+    for layer, by_net in area.items():
+        net = max(by_net, key=by_net.get, default=None)
+        if net is not None and by_net[net] >= PLANE_COVER * board:
+            planes[layer] = net
+    return planes
+
+
 def _zone_clearance(z) -> float:
     c = getattr(z, 'clearance', None)
     return float(c) if c is not None and c > 0 else 0.0
