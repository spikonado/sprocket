{
	"$schema": "https://turborepo.dev/schema.json",
	"ui": "tui",
	"globalDependencies": [".env", "turbo-cache-key.json"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", "turbo-cache-key.json"],
			"outputs": [".svelte-kit/**", ".vercel/**", "dist/**", "target/**"]
		},
		"build:release": {
			"dependsOn": ["^build:release"],
			"inputs": ["$TURBO_DEFAULT$", "turbo-cache-key.json"],
			"outputs": [".svelte-kit/**", ".vercel/**", "dist/**", "target/**"]
		},
		"check": {
			"dependsOn": ["^check"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"test": {
			"dependsOn": ["^test"]
		}
	}
}
