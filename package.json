{
	"name": "@sprocket/monorepo",
	"private": true,
	"license": "Apache-2.0",
	"scripts": {
		"build": "node ./scripts/create-turbo-cache-key.js && bunx turbo run build",
		"build:release": "node ./scripts/create-turbo-cache-key.js && bunx turbo run build:release",
		"dev": "bun --env-file=.env.dev scripts/run-dev.mjs",
		"dev:desktop": "bun --env-file=.env.dev scripts/run-dev.mjs --desktop",
		"test": "turbo run test"
	},
	"devDependencies": {
		"concurrently": "^10.0.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.0.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.9.8"
	},
	"engines": {
		"bun": "^1.3.9",
		"node": "^24.14.0"
	},
	"packageManager": "bun@1.3.11",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"patchedDependencies": {
		"@exalabs/convex-exa@0.1.0": "patches/@exalabs%2Fconvex-exa@0.1.0.patch"
	}
}
