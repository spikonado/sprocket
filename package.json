{
	"name": "@sprocket/monorepo",
	"private": true,
	"license": "FSL-1.1-ALv2",
	"scripts": {
		"build": "node ./scripts/create-turbo-cache-key.js && bunx turbo run build",
		"build:release": "node ./scripts/create-turbo-cache-key.js && bunx turbo run build:release",
		"dev": "bun scripts/run-dev.mjs --env-file=apps/web/.env.local --data-dir=.sprocket-dev",
		"dev:prod": "bun scripts/run-dev.mjs --env-file=apps/web/.env.prod",
		"dev:desktop": "bun scripts/run-dev.mjs --env-file=apps/web/.env.local --desktop --data-dir=.sprocket-dev",
		"dev:prod:desktop": "bun scripts/run-dev.mjs --env-file=apps/web/.env.prod --desktop",
		"test": "bun run test:anti-slop && turbo run test && node --test npm/sprocket/test/*.test.js",
		"test:anti-slop": "node --test tools/oxlint/anti-slop/rules/*.test.ts tools/oxlint/anti-slop/effect/rules/*.test.ts",
		"check:anti-slop": "bun run --cwd apps/web check:anti-slop",
		"check": "bun run check:anti-slop && bun turbo run check",
		"lint:oxlint": "oxlint",
		"lint:mermaid": "mermaid-lint --quiet"
	},
	"devDependencies": {
		"@mermaid-lint/cli": "0.53.1",
		"@oxlint/plugins": "1.86.0",
		"concurrently": "^10.0.0",
		"oxlint": "1.86.0",
		"prettier": "^3.8.3",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"turbo": "^2.9.8"
	},
	"engines": {
		"bun": "^1.4.2",
		"node": "^24.14.0"
	},
	"packageManager": "bun@1.4.2",
	"workspaces": [
		"apps/*",
		"packages/*"
	]
}
