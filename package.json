{
	"name": "@sprocket/monorepo",
	"private": true,
	"license": "FSL-1.1-ALv2",
	"scripts": {
		"dev": "bun scripts/run-dev.mjs --env-file=apps/web/.env.local --data-dir=.sprocket-dev",
		"dev:prod": "bun scripts/run-dev.mjs --env-file=apps/web/.env.prod",
		"dev:desktop": "bun scripts/run-dev.mjs --env-file=apps/web/.env.local --desktop --data-dir=.sprocket-dev",
		"dev:prod:desktop": "bun scripts/run-dev.mjs --env-file=apps/web/.env.prod --desktop",
		"test": "bun run test:anti-slop && node --test tools/connectors/*.test.ts && bun run --workspaces --if-present test && node --test npm/sprocket/test/*.test.js",
		"test:anti-slop": "node --test tools/oxlint/anti-slop/rules/*.test.ts tools/oxlint/anti-slop/effect/rules/*.test.ts",
		"check:anti-slop": "bun run --cwd apps/web check:anti-slop",
		"check": "bun run check:anti-slop && bun run --workspaces --if-present check",
		"lint:oxlint": "oxlint",
		"lint:mermaid": "mermaid-lint --quiet"
	},
	"devDependencies": {
		"@convex-dev/eslint-plugin": "5.0.1",
		"@mermaid-lint/cli": "0.53.1",
		"@oxlint/plugins": "1.93.0",
		"@posthog/cli": "catalog:",
		"concurrently": "^10.0.0",
		"convex": "catalog:",
		"oxlint": "1.93.0",
		"tldts": "7.4.19",
		"vercel": "catalog:",
		"workos": "catalog:",
		"wrangler": "^4.164.0"
	},
	"engines": {
		"bun": "^1.4.4",
		"node": "^26.0.0"
	},
	"packageManager": "bun@1.4.4",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"catalog": {
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@posthog/cli": "^0.19.0",
		"@posthog/rollup-plugin": "^1.6.2",
		"@tailwindcss/vite": "^4.2.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"clsx": "^2.1.1",
		"convex": "^1.45.0",
		"posthog-js": "^1.438.15",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.5.0",
		"tailwindcss": "^4.2.4",
		"vercel": "^66.2.0",
		"workos": "^0.24.0",
		"zod": "^4.1.8"
	},
	"trustedDependencies": [
		"@posthog/cli",
		"core-js",
		"electron-winstaller",
		"esbuild"
	]
}
