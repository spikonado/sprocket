---
import AppWindow from '@/components/sprocket/app-window.astro';
import Step from '@/components/sprocket/mock-step.astro';
---

<AppWindow
	thread="Order controller parts"
	label="Sprocket ordering the parts in a bill of materials after you approve the purchase with a passkey"
>
	<Step step={0} kind="user">Order the parts in the BOM.</Step>
	<Step step={1} kind="web">All 14 parts in stock</Step>
	<Step step={2} kind="text">
		<div class="rounded-xl border border-border/80 bg-background/50 p-3">
			<p class="font-medium">Approve $72.40 at Volt &amp; Wire Supply</p>
			<p
				class="mt-3 inline-flex rounded-full bg-foreground px-3 py-1 text-xs font-medium text-background"
			>
				Approve with passkey
			</p>
		</div>
	</Step>
	<Step step={3} kind="done">Approved $72.40</Step>
	<Step step={4} kind="command">Checked out 14 items · $72.40</Step>
	<Step step={5} kind="text" class="mt-1">Order placed. The confirmation is in your email.</Step>
</AppWindow>
