---
import AppWindow from '@/components/sprocket/app-window.astro';
import Step from '@/components/sprocket/mock-step.astro';
---

<AppWindow
	thread="Order controller parts"
	label="Sprocket ordering the parts in a bill of materials after you approve a one-time spending limit with a passkey"
>
	<Step step={0} kind="user">Order the parts in the BOM.</Step>
	<Step step={1} kind="web">All 14 parts in stock</Step>
	<Step step={2} kind="text">
		<div class="rounded-xl border border-border/80 bg-background/50 p-3">
			<p class="font-medium">Approve a spending limit</p>
			<dl class="mt-2 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-xs">
				<dt class="text-muted-foreground">Merchant</dt>
				<dd>Volt &amp; Wire Supply</dd>
				<dt class="text-muted-foreground">Limit</dt>
				<dd>$85.00, one time</dd>
			</dl>
			<p
				class="mt-3 inline-flex rounded-full bg-foreground px-3 py-1 text-xs font-medium text-background"
			>
				Approve with passkey
			</p>
		</div>
	</Step>
	<Step step={3} kind="done">Approved $85.00 limit</Step>
	<Step step={4} kind="command">Checked out 14 items · $72.40</Step>
	<Step step={5} kind="text" class="mt-1">
		Order placed. The confirmation is in your email, and $12.60 of the limit was released.
	</Step>
</AppWindow>
