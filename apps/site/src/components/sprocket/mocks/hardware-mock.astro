---
import render from '@/assets/power-board-pcb.webp';
import AppWindow from '@/components/sprocket/app-window.astro';
import Step from '@/components/sprocket/mock-step.astro';
---

<AppWindow
	thread="USB-C power board"
	label="Sprocket designing a USB-C power board in KiCad: it reads datasheets, draws the schematic, routes a 4-layer PCB that passes DRC, shows a 3D render of the board, then exports Gerbers and assembly files for PCBWay"
>
	<Step step={0} kind="user"
		>Design a board that charges a 1S–4S battery over USB-C and drives four programmable
		outputs.</Step
	>
	<Step step={1} kind="web">Read BQ25798, BQ40Z50-R2, and TPS55288 datasheets</Step>
	<Step step={2} kind="file">Drew 7 schematic sheets in KiCad</Step>
	<Step step={3} kind="command">Routed the 4-layer PCB · 0 DRC errors</Step>
	<Step step={4} kind="text">
		<figure class="overflow-hidden rounded-xl border border-border/80 bg-background/50">
			<img
				src={render.src}
				width={render.width}
				height={render.height}
				alt=""
				loading="lazy"
				decoding="async"
				class="h-auto w-full px-4 pt-3"
			/>
			<figcaption
				class="flex items-center justify-between gap-2 border-t border-border/70 px-3 py-2 text-xs"
			>
				<span class="shrink-0 font-mono">power-board.kicad_pro</span>
				<span class="truncate text-muted-foreground">145 × 120 mm · 4 layers, 2 oz · 368 parts</span>
			</figcaption>
		</figure>
	</Step>
	<Step step={5} kind="file">Exported Gerbers, BOM, and pick-and-place for PCBWay</Step>
	<Step step={6} kind="done">Wrote docs/assembly.md and docs/ordering.md</Step>
</AppWindow>
