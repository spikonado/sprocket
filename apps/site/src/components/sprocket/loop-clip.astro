---
import { cn } from '@/utils';

interface Props {
	src: string;
	poster: string;
	label: string;
	class?: string;
}

const { src, poster, label, class: className } = Astro.props;
---

<video
	data-loop-clip
	class={cn('block h-auto w-full', className)}
	poster={poster}
	aria-label={label}
	muted
	loop
	playsinline
	controls
	preload="none"
>
	<source src={src} type="video/mp4" />
</video>

<script>
	const clips = document.querySelectorAll<HTMLVideoElement>('[data-loop-clip]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	const observer = new IntersectionObserver(
		(entries) => {
			for (const { target, isIntersecting } of entries) {
				if (!(target instanceof HTMLVideoElement)) continue;

				if (!isIntersecting) target.pause();
				else if (!reduceMotion) void target.play().catch(() => {});
			}
		},
		{ threshold: 0.4 }
	);

	for (const clip of clips) observer.observe(clip);
</script>
