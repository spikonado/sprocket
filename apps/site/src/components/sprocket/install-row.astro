---
import CopyCommand from '@/components/copy-command.svelte';
import SprocketDownload from '@/components/sprocket-download.svelte';
import { SPROCKET_NPM_COMMAND, type SprocketRelease } from '@/lib/sprocket-releases';
import { cn } from '@/utils';

interface Props {
	release: SprocketRelease | null;
	showAlternates?: boolean;
	class?: string;
}

const { release, showAlternates = true, class: className } = Astro.props;
const controlClass = 'h-12 w-full rounded-xl text-left sm:w-auto';
---

<!-- `contents` puts the download button and its platform links in this row's flex flow. -->
<div class={cn('mx-auto flex max-w-xl flex-wrap justify-center gap-3', className)}>
	<SprocketDownload
		client:idle
		{release}
		{showAlternates}
		class="contents"
		buttonClass={controlClass}
		alternatesClass="order-last mt-1 basis-full text-center"
	/>
	<CopyCommand
		client:idle
		command={SPROCKET_NPM_COMMAND}
		class={cn(
			controlClass,
			'border-foreground/12 bg-surface py-0 pr-1.5 shadow-[0_10px_28px_-16px_oklch(0.2_0.02_260/0.55)]'
		)}
	/>
</div>
