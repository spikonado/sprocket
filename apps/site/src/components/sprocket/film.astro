---
interface Props {
	src: string;
	poster: string;
	label: string;
}

const { src, poster, label } = Astro.props;
---

<video
	data-film
	class="block aspect-video h-auto w-full bg-ink"
	poster={poster}
	aria-label={label}
	controls
	playsinline
	preload="none"
>
	<source src={src} type="video/mp4" />
</video>

<script>
	import { track } from '@/lib/analytics/client';

	const film = document.querySelector<HTMLVideoElement>('[data-film]');

	film?.addEventListener('play', () => track('product_film_played', {}, film), { once: true });
</script>
