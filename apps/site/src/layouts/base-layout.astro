---
import '@fontsource-variable/dm-sans/wght.css';
import '@fontsource-variable/ibm-plex-sans/wght.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@/styles/global.css';
import logoSvg from '@/assets/logo.svg';
import Navbar from '@/components/navbar.svelte';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '@/lib/og-image';
import {
	DEFAULT_DESCRIPTION,
	DEFAULT_OG_IMAGE,
	DEFAULT_TITLE,
	ORGANIZATION_SAME_AS,
	SITE_NAME,
	SITE_URL,
	TWITTER_HANDLE,
	absoluteUrl
} from '@/lib/seo';

interface Props {
	title?: string;
	description?: string;
	/** Path or absolute URL for social preview image. */
	image?: string;
	/** Optional JSON-LD objects merged after the default Organization graph. */
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	noindex?: boolean;
}

const {
	title = DEFAULT_TITLE,
	description = DEFAULT_DESCRIPTION,
	image = DEFAULT_OG_IMAGE,
	jsonLd,
	noindex = false
} = Astro.props;

const canonicalURL = absoluteUrl(Astro.url.pathname, Astro.site ?? SITE_URL);
const imageURL = absoluteUrl(image, Astro.site ?? SITE_URL);
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';

const organizationLd = {
	'@type': 'Organization',
	'@id': `${SITE_URL}/#organization`,
	name: SITE_NAME,
	url: SITE_URL,
	logo: absoluteUrl(logoSvg.src, Astro.site ?? SITE_URL),
	description: DEFAULT_DESCRIPTION,
	sameAs: [...ORGANIZATION_SAME_AS],
	email: 'privacy@spikonado.com'
};

const websiteLd = {
	'@type': 'WebSite',
	'@id': `${SITE_URL}/#website`,
	name: SITE_NAME,
	url: SITE_URL,
	description: DEFAULT_DESCRIPTION,
	publisher: { '@id': `${SITE_URL}/#organization` },
	inLanguage: 'en'
};

const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const jsonLdDocument = {
	'@context': 'https://schema.org',
	'@graph': [organizationLd, websiteLd, ...extraLd]
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light" />
		<meta name="theme-color" content="#f0f4eb" />
		<link rel="icon" type="image/svg+xml" href={logoSvg.src} />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="canonical" href={canonicalURL} />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="robots" content={robots} />
		<meta name="author" content={SITE_NAME} />
		<meta name="generator" content={Astro.generator} />

		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
		<meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
		<meta property="og:image:type" content="image/png" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={TWITTER_HANDLE} />
		<meta name="twitter:creator" content={TWITTER_HANDLE} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />
		<meta name="twitter:image:alt" content={title} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLdDocument)} />

		<script>
			import { initBotId } from 'botid/client/core';
			import { initAnalytics } from '@/lib/analytics/client';

			initAnalytics();

			const bootBotId = () => {
				initBotId({
					protect: [{ path: '/api/build-log/subscribe', method: 'POST' }]
				});
			};

			if (typeof requestIdleCallback === 'function') {
				requestIdleCallback(bootBotId, { timeout: 2000 });
			} else {
				setTimeout(bootBotId, 1);
			}
		</script>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-100 focus:rounded-full focus:bg-foreground focus:px-4 focus:py-2 focus:text-sm focus:text-background"
		>
			Skip to content
		</a>
		<Navbar client:idle />
		<slot />
	</body>
</html>
