{
	"name": "@sprocket/desktop",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./main.mjs",
	"scripts": {
		"dev": "bun run --cwd ../../packages/native build:debug && wait-on http-get://localhost:5173 && node ./launch.cjs",
		"build": "bun run --cwd ../../packages/native build && bun run --cwd ../web build && electron-builder"
	},
	"build": {
		"appId": "com.spikonado.sprocket",
		"productName": "Sprocket",
		"directories": {
			"output": "dist"
		},
		"files": [
			"main.mjs",
			"preload.cjs",
			"package.json",
			{
				"from": "../web/dist/",
				"to": "web/dist/",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "../../packages/native/",
				"to": "native/",
				"filter": [
					"index.js",
					"index.d.ts",
					"*.node"
				]
			}
		],
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development"
		}
	},
	"devDependencies": {
		"electron": "^41.5.0",
		"electron-builder": "^26.8.1",
		"wait-on": "^9.0.5"
	}
}
