{
	"name": "@sprocket/desktop",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"main": "./main.mjs",
	"scripts": {
		"dev": "cargo build -q -p sprocket-cli && node ./launch.cjs",
		"build": "cargo build --release -p sprocket-cli && bun run --cwd ../web build && electron-builder"
	},
	"build": {
		"appId": "com.spikonado.sprocket",
		"productName": "Sprocket",
		"directories": {
			"output": "dist"
		},
		"files": [
			"main.mjs",
			"preload.cjs",
			"package.json",
			{
				"from": "../web/dist/",
				"to": "web/dist/",
				"filter": [
					"**/*"
				]
			},
			{
				"from": "../../target/release/sprocket",
				"to": "server/sprocket"
			}
		],
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development"
		}
	},
	"devDependencies": {
		"electron": "^41.5.0",
		"electron-builder": "^26.8.1"
	}
}
