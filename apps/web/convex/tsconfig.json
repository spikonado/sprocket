{
	"compilerOptions": {
		"allowJs": true,
		"strict": true,
		"paths": {
			"@convex/*": ["./*"]
		},
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"target": "ESNext",
		"lib": ["ES2023", "dom"],
		"types": ["node"],
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["./**/*"],
	"exclude": ["./_generated", "./**/*.test.ts", "./**/test.setup.ts"]
}
