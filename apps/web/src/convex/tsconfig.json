{
	"compilerOptions": {
		"allowJs": true,
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@convex/*": ["./*"]
		},
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"skipLibCheck": true,
		"allowSyntheticDefaultImports": true,

		"target": "ESNext",
		"lib": ["ES2023", "dom"],
		"forceConsistentCasingInFileNames": true,
		"module": "ESNext",
		"isolatedModules": true,
		"noEmit": true
	},
	"include": ["./**/*"],
	"exclude": ["./_generated"]
}
