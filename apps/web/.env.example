# Client configuration. Never put Dodo credentials in PUBLIC_* variables.
PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
PUBLIC_CONVEX_SITE_URL=https://your-deployment.convex.site

# Set these privately in the matching Convex deployment, not the client build.
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_SECRET=
SPROCKET_MARKETING_ORIGIN=http://localhost:4321
